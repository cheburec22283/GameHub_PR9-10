{
  "uid": "gamehub-red",
  "title": "GameHub — HTTP RED",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Запросы в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(gamehub_http_requests_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Ошибки HTTP 5xx, %",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum by (job) (rate(gamehub_http_requests_total{status=~\"5..\"}[1m])) or 0 * sum by (job) (rate(gamehub_http_requests_total[1m]))) / clamp_min(sum by (job) (rate(gamehub_http_requests_total[1m])), 0.000001)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "95-й перцентиль времени ответа",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamehub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(gamehub_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Доступность целей",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gamehub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\".*-service\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
